{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui",
            "ground",
            "fixed"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "sky_islands:item/netherite_windspear"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "sky_islands:item/netherite_windspear_block"
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui",
            "ground",
            "fixed"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "sky_islands:item/netherite_windspear"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "sky_islands:item/netherite_windspear_in_hand"
      }
    }
  }
}