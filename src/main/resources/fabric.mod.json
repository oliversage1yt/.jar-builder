{
	"schemaVersion": 1,
	"id": "sky_islands",
	"version": "${version}",
	"name": "Sky Islands {Islands}",
	"description": "Floating sky islands, archipelagos, towers and ruins high above the overworld! A Vanilla Re-make of the original SkyLands Mod by DeepCanionStudio. This mod pairs with Oliversage1's: Sky Islands {SkyDive} mod!",
	"authors": [
		"Oliversage1"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/sky_islands/icon.png",
