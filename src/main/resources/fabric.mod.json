		"main": [
			"com.skyislands.SkyIslands"
		],
		"client": [
			"com.skyislands.client.SkyIslandsClient"
		]
	},
	"mixins": [
		"sky_islands.mixins.json",
		{
			"config": "sky_islands.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
